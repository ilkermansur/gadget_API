# Kopyala: cp .env.example .env  — .env asla commit edilmez ve paylaşılmaz.

# Zorunlu. Gizli değerleri (resource kimlikleri) şifreler ve oturumu imzalar.
# Uzun, rastgele bir değer ver:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Kaybolursa yedekteki resource kimlikleri okunamaz; yedekle birlikte sakla.
SECRET_KEY=

# Sadece ilk açılışta, veritabanı boşken ilk admin hesabını oluşturur.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Host portları (isteğe bağlı)
APP_PORT=8080
TEST_API_PORT=9000
